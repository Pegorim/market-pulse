{
  "schemaVersion": 1,
  "id": "mateus.market-pulse",
  "name": "Market Pulse",
  "version": "1.2.1",
  "author": "Mateus",
  "license": "MIT",
  "description": "A compact, searchable market, futures, and commodities monitor for the Omarchy bar.",
  "kinds": [
    "bar-widget"
  ],
  "entryPoints": {
    "barWidget": "Panel.qml"
  },
  "barWidget": {
    "displayName": "Market Pulse",
    "description": "Track a selected benchmark, stock, futures contract, or commodity and browse related markets.",
    "category": "Info",
    "allowMultiple": false,
    "defaultSection": "center",
    "defaults": {
      "marketId": "us",
      "instrumentSymbol": "^GSPC",
      "barLabel": "",
      "customSymbol": "",
      "refreshIntervalSec": 60
    },
    "schema": [
      {
        "key": "refreshIntervalSec",
        "type": "integer",
        "label": "Refresh interval (seconds)",
        "min": 30,
        "max": 900,
        "step": 30,
        "defaultValue": 60
      }
    ]
  }
}
